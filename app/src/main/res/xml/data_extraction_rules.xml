<?xml version="1.0" encoding="utf-8"?>
<!-- secrets.xml (the GitHub token) is left out: it's encrypted with a device-bound key. -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="file" path="library.json" />
        <include domain="file" path="sources.json" />
        <include domain="file" path="datastore/settings.preferences_pb" />
    </cloud-backup>
    <device-transfer>
        <include domain="file" path="library.json" />
        <include domain="file" path="sources.json" />
        <include domain="file" path="datastore/settings.preferences_pb" />
    </device-transfer>
</data-extraction-rules>
