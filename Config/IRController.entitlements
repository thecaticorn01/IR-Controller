<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!--
	IR Controller is deliberately not sandboxed. Recent macOS releases deny sandboxed
	apps the `iokit-open-service IOUSBHostInterface` operation even with the
	USB entitlement, which makes the IR blaster impossible to open. The app
	still uses the hardened runtime.
	-->
	<key>com.apple.security.device.usb</key>
	<true/>
	<key>com.apple.security.device.serial</key>
	<true/>
</dict>
</plist>
